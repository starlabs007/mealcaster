# Copy to .env.local (git-ignored) and fill in for local development.
# In GitHub Actions these come from the repo's `production` environment.

# OAuth 2.0 Client ID (Web application). Authorized JavaScript origins must
# include http://localhost:5173 and https://starlabs007.github.io
GOOGLE_CLIENT_ID=
# Browser API key, restricted to the site origins above and to the
# Google Sheets, Google Drive and Google Picker APIs.
GOOGLE_API_KEY=
# Google Cloud project number (used by the file picker).
GOOGLE_APP_ID=
